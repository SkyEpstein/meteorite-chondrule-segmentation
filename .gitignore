# Large user-provided micro-CT data (kept out of git)
ALH83010_z_crop_every4/
ALH83010_z_crop_every4_labeled/
BP.CSV

# Generated figures & verbose run logs (regenerable)
results/*.log

# Large regenerable intermediates. Every reported number lives in the JSON
# results and the figures; these are model outputs and caches, not evidence.
# (gitignore has no inline comments: patterns must be alone on their line)
# ~13 GB of per-model probability maps
results/probs/
# cached SLIC graphs, ~221 MB
results/graph_cache/
results/tierC_shortbudget/
split_cache.npz
*.npy

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store

logs/

# model checkpoints (regenerable, large)
results/checkpoints/
*.pt

# Pre-tiler-fix backup of probability maps and leaderboards (~215 MB local only).
# The killed scaling job's log is the ONLY surviving record of that measurement,
# so it is kept in git; everything else in the directory is regenerable bulk.
results/prefix_tiler_backup/*
!results/prefix_tiler_backup/killed_data_scaling2_job.log
