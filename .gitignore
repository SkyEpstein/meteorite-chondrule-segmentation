# Large user-provided micro-CT data (kept out of git).
# Patterns are repeated without the trailing slash so that SYMLINKS to the data
# are ignored too: a worktree links the data in rather than copying it, and git
# treats a symlink as a file, which a directory-only pattern does not match.
ALH83010_z_crop_every4/
ALH83010_z_crop_every4_labeled/
ALH83010_z_crop_every4
ALH83010_z_crop_every4_labeled
BP.CSV

# Generated figures & verbose run logs (regenerable)
results/*.log

# Large regenerable intermediates. Every reported number lives in the JSON
# results and the figures; these are model outputs and caches, not evidence.
# (gitignore has no inline comments — patterns must be alone on their line)
# ~13 GB of per-model probability maps
results/probs/
# cached SLIC graphs, ~221 MB
results/graph_cache/
results/tierC_shortbudget/
split_cache.npz
*.npy

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store

# audit run logs (regenerable; every reported number lives in the JSON results)
audit_run.log
audit_smoke.log
